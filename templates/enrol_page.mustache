{{!
    @template enrol_stripepayment/enrol_page

    Contents of the enrolment widget on the course enrolment page

    Example context (json):
    {
        "cost": "10.00",
        "currency": "USD",
        "coursename": "Course Name",
        "instanceid": "1",
        "enablecouponsection": true
    }
}}
<div>
    <div class="d-flex justify-content-between mb-2">
        <span>{{# str }} subtotal, enrol_stripepayment {{/ str }}</span>
        <span id="subtotalamount-{{instanceid}}">{{currency}} {{cost}}</span>
    </div>

    {{#enablecouponsection}}
    <div class="mb-3">
        <div class="input-group mb-1" id="couponinputgroup">
            <input type="text" class="form-control" id="coupon-{{instanceid}}" placeholder="{{# str }} entercoupon, enrol_stripepayment {{/ str }}">
            <button id="apply-{{instanceid}}" class="btn btn-secondary">{{# str }} apply, enrol_stripepayment {{/ str }}</button>
        </div>
        <div id="showmessage-{{instanceid}}" class="small"></div>
    </div>
    {{/enablecouponsection}}

    <div id="discountsection-{{instanceid}}" class="d-none mb-2">
        <div class="d-flex justify-content-between">
            <span class="badge bg-secondary" id="discounttag-{{instanceid}}">{{# str }} discount, enrol_stripepayment {{/ str }}</span>
            <span id="discountamountdisplay-{{instanceid}}">-{{currency}} 0.00</span>
        </div>
        <p class="small text-muted mb-0" id="discountnote-{{instanceid}}">{{# str }} discountapplied, enrol_stripepayment {{/ str }}</p>
    </div>

    <div class="d-flex justify-content-between fw-bold border-top pt-2" id="total-{{instanceid}}">
        <span>{{# str }} totaldue, enrol_stripepayment {{/ str }}</span>
        <span id="totalamount-{{instanceid}}">{{currency}} {{cost}}</span>
    </div>

    <div id="paymentresponse-{{instanceid}}" class="alert alert-danger d-none mt-2 mb-0"></div>
</div>

<script src="https://js.stripe.com/v3/"></script>
